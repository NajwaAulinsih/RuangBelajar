<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F0E5">

   <LinearLayout
       android:id="@+id/splashContent"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:gravity="center"
       android:orientation="vertical"
       android:padding="24dp"
       app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent">

      <ImageView
          android:id="@+id/ivLogo"
          android:layout_width="120dp"
          android:layout_height="120dp"
          android:contentDescription="Logo RuangBelajar"
          android:src="@drawable/sunnieuser"
          android:scaleType="fitCenter" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:text="RuangBelajar"
          android:textColor="#49372E"
          android:textSize="30sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="Belajar bersama, tumbuh bersama."
          android:textColor="#8B6B58"
          android:textSize="14sp" />

      <ProgressBar
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:layout_marginTop="32dp"
          android:indeterminateTint="#B96F50" />

   </LinearLayout>

   <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginBottom="28dp"
       android:text="STUDY • SHARE • GROW"
       android:textColor="#8B6B58"
       android:textSize="11sp"
       android:letterSpacing="0.12"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
