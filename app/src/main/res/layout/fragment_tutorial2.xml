<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F0E5"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgTutorial2"
        android:layout_width="220dp"
        android:layout_height="180dp"
        android:src="@drawable/sunnieuser"
        android:scaleType="fitCenter"
        android:contentDescription="Ilustrasi ruang belajar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTutorialTitle2"
        app:layout_constraintVertical_bias="0.25" />

    <TextView
        android:id="@+id/tvTutorialTitle2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jelajahi Ruang Belajar"
        android:textColor="#493D32"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/imgTutorial2" />

    <TextView
        android:id="@+id/tvTutorialDescription2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih topik seperti Pemrograman Android, Basis Data, atau Algoritma. Kamu juga bisa menemukan sumber belajar untuk memperdalam materi."
        android:textColor="#75685B"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTutorialTitle2" />

</androidx.constraintlayout.widget.ConstraintLayout>
