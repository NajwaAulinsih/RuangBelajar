<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F0E5"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgTutorial3"
        android:layout_width="220dp"
        android:layout_height="180dp"
        android:src="@drawable/sunnieuser"
        android:scaleType="fitCenter"
        android:contentDescription="Ilustrasi memulai belajar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTutorialTitle3"
        app:layout_constraintVertical_bias="0.25" />

    <TextView
        android:id="@+id/tvTutorialTitle3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Siap Memulai Belajar?"
        android:textColor="#493D32"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/imgTutorial3" />

    <TextView
        android:id="@+id/tvTutorialDescription3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mulai perjalanan belajarmu bersama RuangBelajar. Pelajari materi, kunjungi sumber belajar, dan tingkatkan kemampuanmu!"
        android:textColor="#75685B"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTutorialTitle3" />

</androidx.constraintlayout.widget.ConstraintLayout>
