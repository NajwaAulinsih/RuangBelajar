<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F0E5"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgTutorial1"
        android:layout_width="220dp"
        android:layout_height="180dp"
        android:src="@drawable/sunnieuser"
        android:scaleType="fitCenter"
        android:contentDescription="Ilustrasi belajar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"
        app:layout_constraintBottom_toTopOf="@id/tvTutorialTitle1" />

    <TextView
        android:id="@+id/tvTutorialTitle1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selamat Datang di RuangBelajar!"
        android:textColor="#493D32"
        android:textSize="23sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/imgTutorial1" />

    <TextView
        android:id="@+id/tvTutorialDescription1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Temukan teman belajar, diskusikan materi perkuliahan, dan kembangkan pemahamanmu bersama mahasiswa lainnya."
        android:textColor="#75685B"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTutorialTitle1" />

</androidx.constraintlayout.widget.ConstraintLayout>
